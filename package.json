{
  "name": "deepseek-office",
  "version": "0.1.0",
  "description": "A playful office visualization for DeepSeek Harness: every session becomes a cow, horse, or sheep coworker.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "assets", "cordis.patch.yml", "README.md", "LICENSE"],
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "office", "agent-visualization", "ai-agent", "developer-toy"],
  "license": "MIT",
  "author": "yinhong-zhou",
  "repository": { "type": "git", "url": "git+https://github.com/yinhong-zhou/Deepseek-office.git" },
  "homepage": "https://github.com/yinhong-zhou/Deepseek-office#readme",
  "bugs": { "url": "https://github.com/yinhong-zhou/Deepseek-office/issues" },
  "engines": { "node": "^22.19.0 || >=24" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "inject": ["@deepseek-ai/dsh-client-runtime"], "platform": "web" }
  },
  "dshClient": { "inject": ["@deepseek-ai/dsh-client-runtime"], "platform": "web" },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-client-runtime": { "optional": true },
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.7",
    "lightningcss": "^1.33.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "0.22.2",
    "typescript": "^5.9.3"
  }
}
